# ECHO Messenger Server Configuration
# Copy to /opt/echo/.env and fill in real values

# Port the server listens on (Caddy reverse proxies to this)
PORT=8090

# PostgreSQL connection string
# Create user: CREATE USER echo_user WITH PASSWORD 'your_password';
# Create db:   CREATE DATABASE echo WITH OWNER echo_user;
DATABASE_URL=postgres://echo_user:CHANGE_ME@127.0.0.1:5432/echo

# Redis (used for rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# Logging level
RUST_LOG=echo_server=info,tower_http=info

# Transparency key encryption password (used to encrypt Ed25519 signing key at rest)
TRANSPARENCY_KEY_PASSWORD=CHANGE_ME

# Path to transparency signing key (auto-generated on first run)
TRANSPARENCY_KEY_PATH=/opt/echo/transparency_signing.key

# Optional: set a specific genesis invite code (otherwise random)
# GENESIS_INVITE=your_code_here
