{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/examples/tauri/src-tauri/tauri.conf.json",
  "productName": "ECHO",
  "version": "0.1.0",
  "identifier": "com.echo.messenger",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ECHO",
        "width": 400,
        "height": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
